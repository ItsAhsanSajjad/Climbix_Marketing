# Climbix Marketing — environment variables
# Copy to `.env.local` (gitignored) and fill in per environment.
# All are OPTIONAL for building: the site builds and runs with none set.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.
# Server-only values (no NEXT_PUBLIC_ prefix) stay on the server.

# Production base URL — used by metadata, canonicals, sitemap, robots, JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.climbix.com

# --- Tracking (loaded only if set; see src/components/seo/AnalyticsScripts.tsx) ---
# Consent Mode v2 defaults to DENIED for ad/analytics storage; tags load but
# stay consent-gated until the visitor accepts via the cookie banner.
# Prefer GTM and manage GA4 / Google Ads / Meta Pixel inside the container.
NEXT_PUBLIC_GTM_ID=
# Standalone fallbacks (skip if using GTM):
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Lead delivery (SERVER-SIDE — required in production) ---
# The form posts to /api/lead, which validates, rate-limits, and forwards the
# lead. Configure at least ONE destination below; with none set the API
# returns 503 and the visitor sees an honest error + direct-email fallback
# (never a false success screen).
#
# Option A — webhook (CRM / Zapier / Make / Slack incoming webhook / n8n):
# receives a JSON POST: { type: "climbix_lead", receivedAt, name, email,
# website, phone, goal, budget, source, attribution: { utm_*, gclid, fbclid, referrer } }
LEAD_WEBHOOK_URL=

# Option B — email via Resend (https://resend.com, free tier available):
# RESEND_API_KEY  — API key from the Resend dashboard (server secret!)
# LEAD_TO_EMAIL   — inbox that receives lead notifications
# LEAD_FROM_EMAIL — verified sender, e.g. "Climbix Leads <leads@climbix.com>".
#                   Falls back to Resend's onboarding sender for testing.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# --- Local testing ---
# 1. `npm run dev`
# 2. Submit the form with no destination set  -> expect the visible error state (503).
# 3. Set LEAD_WEBHOOK_URL to e.g. a https://webhook.site URL and resubmit
#    -> expect redirect to /thank-you and the payload in webhook.site.

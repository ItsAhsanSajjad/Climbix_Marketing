# Climbix Marketing — environment variables
# Copy to `.env.local` (gitignored) and fill in per environment.
# All are OPTIONAL: the site builds and runs with none set. Each tag/feature
# activates only when its variable is present. NEXT_PUBLIC_* values are exposed
# to the browser — never put secret/server keys here.

# Production base URL — used by metadata, canonicals, sitemap, robots, JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.climbix.com

# --- Tracking (loaded only if set; see src/components/seo/AnalyticsScripts.tsx) ---
# Prefer GTM and manage GA4 / Google Ads / Meta Pixel inside the container.
NEXT_PUBLIC_GTM_ID=
# Standalone fallbacks (skip if using GTM):
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Lead form ---
# When set, the lead form POSTs the lead (name, email, goal, budget, UTMs, …)
# to this URL before redirecting to /thank-you. Leave blank to disable sending.
# Point at a serverless route / CRM / form service. Add server-side validation
# and a spam check (e.g. Turnstile) at that endpoint.
NEXT_PUBLIC_LEAD_ENDPOINT=
